# Copy to .env and adjust local overrides. Server deployment lives in ../omniAndRelay.
OMNIAND_PLATFORM_HOST=phone.example.net
OMNIAND_RELAY_URL=wss://relay.phone.example.net/_omniand/tunnel/v1
# Optional for an emulator reaching a local Caddy certificate signed by mkcert; debug APK only.
OMNIAND_DEBUG_CA_CERT=/absolute/path/to/mkcert/rootCA.pem
# Emulator TURN runs on the development host, not inside the Android guest.
OMNIAND_DEBUG_TURN_HOST_ALIAS=10.0.2.2
# Force the remote-camera acceptance path to exercise TURN in local development.
OMNIAND_DEBUG_ICE_RELAY_ONLY=true
